{
  "name": "grade-calculator",
  "version": "0.1.1",
  "description": "A calculator for curriculum grades.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "coverage": "svelte-kit sync && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Tim Jentzsch",
  "license": "MIT",
  "homepage": "https://github.com/TimJentzsch/grade-calculator#readme",
  "bugs": {
    "url": "https://github.com/TimJentzsch/grade-calculator/issues"
  },
  "repository": "github:TimJentzsch/grade-calculator",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "private": true,
  "dependencies": {
    "yalps": "^0.6.4"
  }
}
